# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/lms?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Optional admin seed (required in production when seeding admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-strong-password

PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
GEMINI_API_KEY=your_gemini_api_key_here

# Production only: enable seed routes temporarily, then turn off
# ALLOW_SEED=true
